{
  // Cloudflare builds this repo with `npx wrangler deploy`. There is no
  // server-side code — the "assets" block is what tells Workers to serve the
  // repo as a static site. Without it the deploy succeeds but serves nothing.
  "name": "plearnde-landing-page",
  "compatibility_date": "2026-09-17",
  "assets": {
    // only public/ is served — README, configs and .git stay off the web
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    // a real 404 for missing paths. The SPA fallback would answer every
    // unknown URL with the homepage at status 200, which hides broken links
    // and lets search engines index endless duplicates of it.
    "not_found_handling": "none"
  }
}
